{
  "name": "@wavebirdai/api",
  "version": "0.1.0-beta.17",
  "private": false,
  "type": "module",
  "description": "JavaScript and TypeScript integration for wavebird Banner, Native and Clip ads, with consent and generation lifecycle handling.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wavebird-ai/api"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "src",
    "build.mjs",
    "examples",
    "bin",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/web",
    "python/README.md",
    "python/examples/fastapi_app/README.md"
  ],
  "bin": {
    "wavebird-next": "./bin/wavebird-next.mjs"
  },
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "pretest": "npm run build",
    "prepack": "npm run build"
  },
  "homepage": "https://wavebird.ai/api/quickstart",
  "bugs": {
    "url": "https://github.com/wavebird-ai/api/issues"
  },
  "keywords": [
    "wavebird",
    "advertising",
    "javascript",
    "typescript",
    "ai-apps",
    "consent",
    "publisher-integration"
  ]
}
