{
  "name": "@wavebirdai/api",
  "version": "0.1.0-local.2",
  "private": true,
  "type": "module",
  "description": "Banner/Native publisher integration for the Wavebird API",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "files": ["dist", "examples", "bin", "templates", "README.md", "LICENSE"],
  "bin": { "wavebird-next": "./bin/wavebird-next.mjs" },
  "exports": {
    "./server": { "types": "./dist/server.d.ts", "import": "./dist/server.js" },
    "./browser": { "types": "./dist/browser.d.ts", "import": "./dist/browser.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "pretest": "npm run build",
    "prepack": "npm run build"
  }
}
